# Copia este archivo como .env y llena los valores. El .env NO se sube al repositorio.
# Sin DB_CONTRASENA ni KINET_JWT_SECRET la API no arranca (auditoría 03/11/2026, NC-05).

DB_URL=jdbc:oracle:thin:@//localhost:1522/FREEPDB1
DB_USUARIO=kinet_app
DB_CONTRASENA=
# Mínimo 32 caracteres. Generar con: openssl rand -base64 48
KINET_JWT_SECRET=
KINET_CORS_ORIGENES=http://localhost:4200
KINET_FRONTEND_URL=http://localhost:4200

# Correo (opcional). Sin MAIL_HOST el enlace de recuperación se escribe en la consola.
MAIL_HOST=
MAIL_PUERTO=587
MAIL_USUARIO=
MAIL_CONTRASENA=
