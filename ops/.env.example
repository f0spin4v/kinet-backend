# Copiar a ~/proyecto/.env en el servidor y cambiar los valores (chmod 600). Solo letras y números en las claves.
ORACLE_PASSWORD=
KINET_APP_PASSWORD=
KINET_READER_PASSWORD=
KINET_ADMIN_PASSWORD=
# Mínimo 32 caracteres (openssl rand -hex 32). Sin él la API no arranca.
KINET_JWT_SECRET=
# Dominio público, sin https://
PUBLIC_HOST=kinetapp.duckdns.org

# Opcional: correo para recuperar contraseña
MAIL_HOST=
MAIL_USUARIO=
MAIL_CONTRASENA=

# Opcional: respaldo (ops/respaldo.sh)
# CONTENEDOR_DB=proyecto-db-1
# RESPALDO_S3=s3://<bucket>/diarios
